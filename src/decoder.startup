# Setting the deterministic "Layer 2" MAC address
ip link set dev eth0 address 00:00:00:00:04:01

# Assigning the IPv4 address to the source node
ip address add 10.0.4.1/24 dev eth0
ip link set eth0 up

ip route add default via 10.0.4.254

# Injecting static ARP entries to bypass broadcast delays and ensure immediate transmission to the "Encoder" / "..."
ip neigh add 10.0.4.254 lladdr 00:00:00:00:20:03 dev eth0

# Disabling hardware offloading ( TCP / UDP segmentation ) to guarantee precise packet-level generation and timing
ethtool -K eth0 tx off rx off

# Link capacity ( upper bound )
tc qdisc add dev eth0 root handle 1: netem delay 5ms
tc qdisc add dev eth0 parent 1: handle 2: tbf rate 20mbit burst 100000 limit 125000

# Link capacity ( lower bound )
# tc qdisc change dev eth0 parent 1: handle 2: tbf rate 1mbit burst 10000 limit 12500

# Executing the related micro-service in the background, redirecting standard output and error to a persistent log file
python3 -u /shared/py/decoder.py > /shared/log/decoder.log 2>&1 &
echo "tail -f /shared/log/decoder.log" >> /root/.bashrc