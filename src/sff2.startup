# Setting the deterministic "Layer 2" MAC address
ip link set dev eth0 address 00:00:00:00:20:01
ip link set dev eth1 address 00:00:00:00:20:02
ip link set dev eth2 address 00:00:00:00:20:03

ip link set eth0 up
ip link set eth1 up
ip link set eth2 up

# Link capacities ( upper bound )
tc qdisc add dev eth0 root handle 1: netem delay 2ms
tc qdisc add dev eth0 parent 1: handle 2: tbf rate 50mbit burst 250000 limit 312500

tc qdisc add dev eth1 root handle 1: netem delay 2ms
tc qdisc add dev eth1 parent 1: handle 2: tbf rate 50mbit burst 250000 limit 312500

tc qdisc add dev eth2 root handle 1: netem delay 2ms
tc qdisc add dev eth2 parent 1: handle 2: tbf rate 20mbit burst 100000 limit 125000

# Link capacities ( lower bound )
# tc qdisc change dev eth0 parent 1: handle 2: tbf rate 5mbit burst 25000 limit 31250
# tc qdisc change dev eth1 parent 1: handle 2: tbf rate 5mbit burst 25000 limit 31250
# tc qdisc change dev eth2 parent 1: handle 2: tbf rate 1mbit burst 10000 limit 12500

# Compiling the P4 program from the "shared/p4" folder
p4c /shared/p4/sff.p4

# Starting the "simple_switch" daemon in the background
# Mapping physical interfaces ( ethX ) to P4 logical ports ( 1, 2, 3 )
simple_switch -i 1@eth0 -i 2@eth1 -i 3@eth2 /sff.json &

# Waiting actively until the process is running
while ! pgrep simple_switch > /dev/null; do
    sleep 1
done

# Waiting until the Command Line Interface ( CLI ) is ready to accept commands
until simple_switch_CLI <<< "help" > /dev/null 2>&1; do 
    sleep 1
done

# Injecting the "commands.txt" control plane rules into the switch
simple_switch_CLI < /commands.txt