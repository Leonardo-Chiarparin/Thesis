# Setting the deterministic "Layer 2" MAC address
ip link set dev eth0 address 00:00:00:00:01:01

# Assigning the IPv4 address to the source node
ip address add 10.0.1.1/24 dev eth0
ip link set eth0 up

ip route add default via 10.0.1.254

# Injecting static ARP entries to bypass broadcast delays and ensure immediate transmission to the "Encoder"
ip neigh add 10.0.1.254 lladdr 00:00:00:00:10:01 dev eth0

# Disabling hardware offloading ( TCP / UDP segmentation ) to guarantee precise packet-level generation and timing
ethtool -K eth0 tx off rx off

# Link capacity ( upper bound )
tc qdisc add dev eth0 root handle 1: netem delay 0.5ms
tc qdisc add dev eth0 parent 1: handle 2: tbf rate 10Gbit burst 5000000 limit 6250000

# Link capacity ( lower bound )
# tc qdisc change dev eth0 parent 1: handle 2: tbf rate 1Gbit burst 500000 limit 625000

# Executing the related micro-service in the background, redirecting standard output and error to a persistent log file
# python3 /shared/camera.py > /shared/camera.log 2>&1 &
# echo "tail -f /shared/camera.log" >> /root/.bashrc